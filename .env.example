# =================================================================
#  Tesla NAS Upload - Configuration
#  Edit these values to match your setup
# =================================================================

# Synology shared folder where dashcam files will be saved
# Must already exist before deploying!
UPLOAD_PATH=/volume1/docker/Tesla

# 4-digit PIN to unlock the upload UI in Tesla browser
ACCESS_PIN=7731

# Port exposed to your network (open in browser as http://NAS-IP:3000)
FRONTEND_PORT=3000
